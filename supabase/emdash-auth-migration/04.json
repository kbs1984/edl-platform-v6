SELECT 
  table_schema,
  table_name,
  json_agg(
    json_build_object(
      'column_name', column_name,
      'data_type', data_type,
      'is_nullable', is_nullable,
      'column_default', column_default
    )
  ) AS columns
FROM 
  information_schema.columns
WHERE 
  table_schema = 'public'
GROUP BY 
  table_schema, table_name
ORDER BY 
  table_name;

