{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EDL Platform YAML Frontmatter Schema",
  "description": "Battle-tested schema for YAML frontmatter validation",
  "type": "object",
  "properties": {
    "session": {
      "type": "string",
      "pattern": "^[0-9]{5}$|^legacy$|^multiple$",
      "description": "Session number (00XXX format) or 'legacy' or 'multiple'"
    },
    "type": {
      "type": "string",
      "enum": ["specification", "guide", "report", "analysis", "log", "script", "config", "template", "handoff", "unknown"],
      "description": "Document type classification"
    },
    "status": {
      "type": "string",
      "enum": ["current", "draft", "archived", "superseded"],
      "description": "Document status"
    },
    "created": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "ISO date of creation (YYYY-MM-DD)"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Human-readable title"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "One-line purpose statement"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Flat array of topic tags"
    },
    "priority": {
      "type": "string",
      "enum": ["P0", "P1", "P2"],
      "description": "Implementation priority"
    },
    "domain": {
      "type": "string",
      "enum": ["requirements", "reality", "reconciliation", "core"],
      "description": "System domain"
    },
    "modified": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Last modification date"
    },
    "author": {
      "type": "string",
      "description": "Creator identifier"
    },
    "implements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Files this implements"
    },
    "related_to": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related files"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Files this supersedes"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Dependencies"
    },
    "validation_method": {
      "type": "string",
      "enum": ["automated", "manual", "reality-agent", "none"],
      "description": "How to validate this document"
    },
    "review_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "When to review this"
    },
    "estimated_shelf_life": {
      "type": "string",
      "description": "How long this remains relevant"
    },
    "last_validated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Last validation date"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional search terms"
    },
    "complexity": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced"],
      "description": "Content complexity level"
    },
    "audience": {
      "type": "string",
      "enum": ["developer", "architect", "manager", "all"],
      "description": "Target audience"
    },
    "reading_time": {
      "type": "integer",
      "minimum": 1,
      "description": "Estimated reading time in minutes"
    },
    "weight": {
      "type": "integer",
      "description": "Ordering weight"
    },
    "toc": {
      "type": "boolean",
      "description": "Generate table of contents"
    },
    "cache": {
      "type": "boolean",
      "description": "Can be cached"
    },
    "index_priority": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Search ranking weight"
    },
    "workflow_state": {
      "type": "string",
      "enum": ["draft", "review", "published", "deprecated"],
      "description": "Workflow state"
    },
    "editor_notes": {
      "type": "string",
      "description": "Internal notes"
    },
    "breakthrough": {
      "type": "string",
      "description": "Notable achievement or discovery"
    }
  },
  "required": ["session", "type", "status", "created", "title", "purpose"],
  "additionalProperties": true
}